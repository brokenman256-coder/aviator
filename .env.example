# Copy this file to .env and fill in real values before running in a shared setting.

PORT=3000

# Used to sign login sessions (JWTs). Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Default admin account, created automatically on first run.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aviator.local
ADMIN_PASSWORD=ChangeMe123!

# Starting credits granted to a new account once it verifies its OTP.
SIGNUP_BONUS_CREDITS=1000

# House edge applied to every round, as a percent (e.g. 5 = 5%). Also adjustable
# live from the admin dashboard without restarting the server.
DEFAULT_HOUSE_EDGE_PERCENT=5

# Optional: SMTP settings to actually email OTP codes. If left blank, OTP codes
# are printed to the server console instead (fine for playing with friends).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aviator <no-reply@aviator.local>
