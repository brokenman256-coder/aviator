# Postgres connection string (Neon, Vercel Postgres, Supabase, etc).
# Prefer a *pooled* connection string if your provider offers one (e.g.
# Neon's "pooled" endpoint) — serverless functions open many short-lived
# connections.
DATABASE_URL=postgres://user:password@host:5432/dbname

JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aviator.local
ADMIN_PASSWORD=ChangeMe123!

SIGNUP_BONUS_CREDITS=1000
DEFAULT_HOUSE_EDGE_PERCENT=5

# Optional — leave unset to have OTP codes printed to server logs / returned
# directly in the API response (dev mode) instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aviator <no-reply@aviator.local>
